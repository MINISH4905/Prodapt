# PitchCraft AI - VentureX-Ray
# Module 7: Investor Simulation
# Environment variables

# Google Gemini API key (required to run with a real LLM)
GEMINI_API_KEY=your_api_key_here

# Gemini model to use (sensible default provided)
GEMINI_MODEL=gemini-1.5-flash

# Max number of rounds in an investor simulation session
MAX_ROUNDS=8

# Max number of characters accepted for a single founder answer
MAX_ANSWER_LENGTH=4000

# Max number of prior conversation turns sent to the LLM as context
MAX_HISTORY_TURNS=12
